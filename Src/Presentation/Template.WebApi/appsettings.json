{
  "UseInMemoryDatabase": false,


  "IdentitySettings": {
    "PasswordRequireDigit": true,
    "PasswordRequiredLength": 5,
    "PasswordRequireNonAlphanumeric": true,
    "PasswordRequireUppercase": true,
    "PasswordRequireLowercase": true
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowCredentials": false,
    "RequireAllowedOrigins": false
  },
  "BrasilApiSettings": {
    "Enabled": false,
    "BaseUrl": "https://brasilapi.com.br/api/",
    "Timeout": "00:00:05",
    "MaxRetries": 2,
    "RetryDelay": "00:00:00.200",
    "CircuitBreakerFailureThreshold": 5,
    "CircuitBreakerBreakDuration": "00:00:30"
  },
  "BcbPtaxSettings": {
    "Enabled": false,
    "BaseUrl": "https://olinda.bcb.gov.br/olinda/servico/PTAX/versao/v1/odata/",
    "Timeout": "00:00:05",
    "MaxRetries": 2,
    "RetryDelay": "00:00:00.200",
    "CircuitBreakerFailureThreshold": 5,
    "CircuitBreakerBreakDuration": "00:00:30"
  },
  "FileStorageSettings": {
    "Enabled": false,
    "ContainerName": "template-files",
    "OperationTimeout": "00:00:30",
    "MaxRetries": 2
  },
  "SessionSettings": {
    "AbsoluteLifetime": "7.00:00:00",
    "IdleTimeout": "12:00:00",
    "ReuseGraceWindow": "00:00:10",
    "MaxActiveFamilies": 5,
    "RateLimitPermitLimit": 10,
    "RateLimitWindow": "00:01:00"
  },
  "JwtSettings": {
    "Issuer": "CoreIdentity",
    "Audience": "CoreIdentityUser",
    "DurationInMinutes": 15
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Verbose"
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Elasticsearch",
        "Args": {
          "NodeUris": "http://elasticsearch:9200",
          "IndexFormat": "logs-dotnet-{0:yyyy.MM.dd}",
          "AutoRegisterTemplate": true
        }
      }
    ]
  },
  "LocalizationSettings": {
    "DefaultRequestCulture": "pt-BR",
    "SupportedCultures": [ "pt-BR", "en", "fa" ]
  },
  "ElasticSearchSettings": {
    "Name": "elasticsearch",
    "Url": "http://elasticsearch:9200",
    "Type": "logs-api",
    "DataSet": "example",
    "Namespace": "demo",
    "DefaultIndex": "persons"
  },

  "RabbitMqSettings": {
    "Port": 5672,
    "UserName": "kalo",
    "HostName": "rabbitmq"
  }
}
