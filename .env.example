# Copy this file to .env and replace every CHANGE_ME value. Never commit .env.
# PostgreSQL
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB_NAME=TemplateCleanArch
POSTGRES_IDENTITY_DB_NAME=TemplateCleanArchIdentity

# RabbitMQ
RABBITMQ_DEFAULT_USER=CHANGE_ME
RABBITMQ_DEFAULT_PASS=CHANGE_ME

# Redis
REDIS_PASSWORD=CHANGE_ME
# Redis Insight (local tooling): encrypts the saved connection password in its volume. Keep it stable for that volume.
REDIS_INSIGHT_ENCRYPTION_KEY=CHANGE_ME

# Azurite (Phase 30): local blob storage account for report outputs. The key must be Base64 (for example 32 hex characters).
AZURITE_ACCOUNT_NAME=templatefiles
AZURITE_ACCOUNT_KEY=CHANGE_ME

# App settings
# JWT signing key (Phase 22): at least 32 bytes from a cryptographically secure generator, for example
#   powershell -NoProfile -Command "$b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)"
# Rotate by replacing the value and restarting the WebApi; tokens signed with the previous key stop validating.
JwtSettings__Key=CHANGE_ME
# Approval workflow internal key (Phase 31): shared by the WebApi, the Worker and the WorkflowFunctions host; at least
# 32 characters from a secure generator (same command as above). Rotate by replacing it and restarting the three services.
APPROVAL_WORKFLOW_KEY=CHANGE_ME
ASPNETCORE_CERTIFICATE_PASSWORD=CHANGE_ME
APPDATA=CHANGE_ME_LOCAL_PATH

# Ports
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601
REDIS_PORT=6379
REDIS_INSIGHT_PORT=6380
WEBAPI_HTTP_PORT=8080
WEBAPI_HTTPS_PORT=8081
