# Copy this file to .env and replace every CHANGE_ME value. Never commit .env.
# PostgreSQL
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB_NAME=TemplateCleanArch
POSTGRES_IDENTITY_DB_NAME=TemplateCleanArchIdentity

# RabbitMQ
RABBITMQ_DEFAULT_USER=CHANGE_ME
RABBITMQ_DEFAULT_PASS=CHANGE_ME

# Redis
REDIS_PASSWORD=CHANGE_ME

# App settings
ASPNETCORE_CERTIFICATE_PASSWORD=CHANGE_ME
APPDATA=CHANGE_ME_LOCAL_PATH

# Ports
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601
REDIS_PORT=6379
REDIS_INSIGHT_PORT=6380
REDIS_GRAPH_PORT=6381
REDIS_SEARCH_PORT=6382
REDIS_TIMESERIES_PORT=6383
WEBAPI_HTTP_PORT=8080
WEBAPI_HTTPS_PORT=8081
