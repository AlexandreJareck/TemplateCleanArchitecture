<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Phase 33 opt-in volume performance suite (NFR-PERF-1/2/3/5/6). Requires Docker: it starts disposable PostgreSQL and
    RabbitMQ containers pinned by digest, seeds the synthetic NFR dataset and measures the budgets. Not part of the
    fast CI gate.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.RabbitMq" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Src\Presentation\Template.WebApi\Template.WebApi.csproj" />
    <!-- The Worker's top-level Program would clash with the WebApi's, so it is referenced under an alias. -->
    <ProjectReference Include="..\..\Src\Workers\Template.Worker\Template.Worker.csproj" Aliases="worker" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
