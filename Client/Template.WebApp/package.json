{
  "name": "template-web-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --ssl --proxy-config proxy.conf.json",
    "build": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "test": "ng test --watch=false",
    "test:domain": "vitest run src/app/domain src/app/application",
    "test:adapters": "vitest run src/app/infrastructure",
    "test:components": "vitest run src/app/presentation",
    "architecture": "depcruise --config dependency-cruiser.config.cjs src/app",
    "architecture:mutations": "node tools/test-architecture-mutations.mjs",
    "api:generate": "orval --config orval.config.ts && node tools/normalize-generated-output.mjs",
    "api:drift": "node tools/check-api-drift.mjs",
    "audit:licenses": "node tools/check-licenses.mjs",
    "audit:security": "pnpm audit --audit-level high",
    "e2e": "playwright test",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm architecture && pnpm architecture:mutations && pnpm api:drift && pnpm build"
  },
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "24.22.0",
    "pnpm": "12.14.0"
  },
  "dependencies": {
    "@angular/cdk": "22.2.3",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@jsverse/transloco": "8.4.0",
    "@ng-icons/core": "33.4.0",
    "@ng-icons/lucide": "33.4.0",
    "@spartan-ng/brain": "1.8.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "luxon": "3.7.2",
    "rxjs": "7.8.2",
    "tailwind-merge": "3.5.0",
    "tslib": "2.8.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "angular-eslint": "22.6.0",
    "dependency-cruiser": "18.6.0",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "orval": "8.43.0",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
